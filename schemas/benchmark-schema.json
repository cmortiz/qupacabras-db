{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quantum Benchmark Schema",
  "description": "Schema for validating quantum experiment benchmark submissions",
  "type": "object",
  "required": [
    "algorithmName",
    "device",
    "metricName",
    "metricValue"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (auto-generated if not provided)",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 3,
      "maxLength": 50
    },
    "algorithmName": {
      "type": "string",
      "description": "Name of the quantum experiment",
      "minLength": 3,
      "maxLength": 100
    },
    "device": {
      "type": "string",
      "description": "Quantum device or simulator used",
      "minLength": 3,
      "maxLength": 100
    },
    "metricName": {
      "type": "string",
      "description": "Performance metric measured (e.g., Fidelity, Success Rate, Execution Time)",
      "minLength": 3,
      "maxLength": 100
    },
    "metricValue": {
      "type": "number",
      "description": "Numerical result of the metric",
      "minimum": 0,
      "maximum": 1e6
    },
    "uncertainty": {
      "type": [
        "number",
        "null"
      ],
      "description": "Statistical uncertainty of the measurement",
      "minimum": 0,
      "maximum": 1e6
    },
    "paperUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL to the published paper",
      "format": "uri",
      "pattern": "^https?://"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 formatted timestamp (auto-generated if not provided)",
      "format": "date-time"
    },
    "lastUpdated": {
      "type": "string",
      "description": "ISO 8601 formatted timestamp of the last update",
      "format": "date-time"
    },
    "contributor": {
      "type": [
        "string",
        "null"
      ],
      "description": "GitHub username of the contributor",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-])*$",
      "maxLength": 39
    },
    "experimentDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 formatted date when the experiment was performed",
      "format": "date-time"
    },
    "team": {
      "type": "array",
      "description": "List of team members/authors",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "minItems": 1,
      "maxItems": 20
    },
    "qasmFiles": {
      "type": "array",
      "description": "List of QASM circuit files",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+\\.qasm$"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "nonlocalGame": {
      "type": "object",
      "description": "Recomputable nonlocal-game claim. Present when the submission ships the per-question measurement counts behind its result, so the reported win rate is recalculated from the raw data at build time instead of taken on trust. Optional: entries without it are stored as unverified assertions.",
      "required": [
        "game",
        "winRate",
        "shotsPerCircuit",
        "countsFile"
      ],
      "additionalProperties": false,
      "properties": {
        "game": {
          "type": "string",
          "description": "Registry name of the game, resolved by the game registry under scripts/lib/nlg/",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "params": {
          "type": "object",
          "description": "Integer parameters selecting a member of the game family, for example { \"n\": 3 } for the odd cycle C_3",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "winRate": {
          "type": "number",
          "description": "Authoritative full-precision win rate claim: the unweighted mean of the per-question win rates. Checked tightly against the value recomputed from countsFile. Top-level metricValue is a display value and is checked loosely.",
          "minimum": 0,
          "maximum": 1
        },
        "shotsPerCircuit": {
          "type": "integer",
          "description": "Shot count per question circuit, constant across every question unless allowVariableShots is set",
          "minimum": 1
        },
        "countsFile": {
          "type": "string",
          "description": "Bare filename of the counts document inside the same submission folder. Path separators are rejected, so the reference cannot escape the folder.",
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "uncertainty": {
          "type": "number",
          "description": "Uncertainty on winRate, at full precision",
          "minimum": 0
        },
        "uncertaintyDefinition": {
          "type": "string",
          "description": "How the uncertainty was derived, for example the 95% confidence half-width",
          "maxLength": 500
        },
        "allowVariableShots": {
          "type": "boolean",
          "description": "Escape hatch for runs whose per-question shot totals differ. Downgrades the shot mismatch from an error to a warning and marks the confidence interval approximate.",
          "default": false
        },
        "eventTeam": {
          "type": "string",
          "description": "Event layer, optional and removable: the team name a submission is ranked under",
          "minLength": 1,
          "maxLength": 100
        },
        "provenance": {
          "type": "object",
          "description": "Event layer, optional and removable: free-form record of where the counts came from, for example provider job identifiers",
          "additionalProperties": true
        }
      }
    },
    "graph": {
      "type": "object",
      "description": "Optional submitter-provided explicit graph used as preferred lambda1 source, e.g. { \"edges\": [[0,1],[1,2]] }",
      "properties": {
        "edges": {
          "type": "array",
          "description": "Undirected edge list as integer node index pairs",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": true
    },
    "lambda1": {
      "type": [
        "number",
        "null"
      ],
      "description": "Computed second-smallest normalized-Laplacian eigenvalue (spectral gap)"
    },
    "lambda1Source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Computed lambda1 source: explicit or qasm",
      "enum": [
        "explicit",
        "qasm",
        null
      ]
    },
    "generalMetrics": {
      "type": "object",
      "description": "General platform metrics comparable across problem types",
      "properties": {
        "lambda1": { "type": ["number", "null"] },
        "lambda1Source": { "type": ["string", "null"], "enum": ["explicit", "qasm", null] },
        "circuitDepth": { "type": ["number", "null"], "minimum": 0 },
        "gateFidelity": {
          "type": "object",
          "properties": {
            "oneQubit": { "type": ["number", "null"], "minimum": 0 },
            "twoQubit": { "type": ["number", "null"], "minimum": 0 },
            "measurementMethod": { "type": ["string", "null"] },
            "reference": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "readoutFidelity": { "type": ["number", "null"], "minimum": 0 },
        "qubitFidelity": { "type": ["number", "null"], "minimum": 0 },
        "timing": {
          "type": ["object", "null"],
          "properties": {
            "circuitDuration": { "type": ["number", "null"], "minimum": 0 },
            "t1": { "type": ["number", "null"], "minimum": 0 },
            "t2": { "type": ["number", "null"], "minimum": 0 },
            "unit": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "runtimeOverT1": { "type": ["number", "null"], "minimum": 0 },
        "runtimeOverT2": { "type": ["number", "null"], "minimum": 0 },
        "qubitTimeVolume": { "type": ["number", "null"], "minimum": 0 },
        "qubitTimeVolumeNormalized": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "problemSpecific": {
      "type": "object",
      "description": "Problem-specific metrics and context",
      "properties": {
        "description": { "type": ["string", "null"] },
        "primaryMetric": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "definition": { "type": ["string", "null"] },
            "value": { "type": ["number", "null"] },
            "uncertainty": { "type": ["number", "null"], "minimum": 0 },
            "uncertaintyDefinition": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "qubitRange": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "depthRange": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "shots": { "type": ["number", "null"], "minimum": 0 },
        "methodology": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "description": {
      "type": "string",
      "description": "Brief description of the benchmark",
      "maxLength": 500
    },
    "methodology": {
      "type": "string",
      "description": "How the benchmark was performed",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or caveats",
      "maxLength": 1000
    },
    "quantumSpecific": {
      "type": "object",
      "description": "Optional quantum-specific properties",
      "properties": {
        "qubitCount": {
          "type": "integer",
          "description": "Number of qubits used",
          "minimum": 1
        },
        "gateCount": {
          "type": "integer",
          "description": "Total number of quantum gates",
          "minimum": 0
        },
        "circuitDepth": {
          "type": "integer",
          "description": "Depth of the quantum circuit",
          "minimum": 0
        },
        "shots": {
          "type": "integer",
          "description": "Number of measurement repetitions",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "description": "Optional execution environment details",
      "additionalProperties": true
    },
    "errorRates": {
      "type": "object",
      "description": "Optional error rate measurements",
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "description": "Optional submitter-reported circuit timing and coherence values",
      "properties": {
        "circuitDuration": {
          "type": "number",
          "description": "Hardware circuit execution duration",
          "minimum": 0
        },
        "t1": {
          "type": "number",
          "description": "Representative T1 coherence time",
          "minimum": 0
        },
        "t2": {
          "type": "number",
          "description": "Representative T2 coherence time",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "description": "Timing unit for circuitDuration, t1, and t2",
          "default": "us"
        }
      },
      "additionalProperties": true
    },
    "qubitTimeVolume": {
      "type": [
        "number",
        "null"
      ],
      "description": "Computed qubit time volume: qubitCount * timing.circuitDuration (qubit*us)"
    },
    "qubitTimeVolumeNormalized": {
      "type": [
        "number",
        "null"
      ],
      "description": "Computed normalized qubit time volume: (qubitCount * timing.circuitDuration) / timing.t2"
    },
    "executionTime": {
      "type": "object",
      "description": "Optional execution time statistics",
      "additionalProperties": true
    },
    "verification": false
  },
  "additionalProperties": true
}
